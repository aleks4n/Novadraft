### 2. `generate_hello.py` – Code

```python
#!/usr/bin/env python3
"""
generate_hello.py

Creates a minimal “Hello, World!” Python program and saves it as
hello_world/hello_world.py.

The generated script is fully functional and can be executed directly:

    $ python hello_world/hello_world.py
    Hello, World!
"""

import os
import pathlib
import sys
from typing import Final

# ----------------------------------------------------------------------
# Configuration (constants)
# ----------------------------------------------------------------------
TARGET_DIR: Final[pathlib.Path] = pathlib.Path(__file__).resolve().parent / "hello_world"
TARGET_FILE: Final[pathlib.Path] = TARGET_DIR / "hello_world.py"

# The exact source code that will be written to the target file.
HELLO_WORLD_SOURCE: Final[str] = """#!/usr/bin/env python3
\"\"\"hello_world.py

A minimal script that prints “Hello, World!” when executed.
\"\"\"

def main() -> None:
    \"\"\"Entry point – prints a greeting to standard output.\"\"\"
    print("Hello, World!")


if __name__ == "__main__":
    # When the module is run as a script, invoke main().
    main()
"""

# ----------------------------------------------------------------------
# Helper functions
# ----------------------------------------------------------------------
def ensure_target_dir(path: pathlib.Path) -> None:
    """
    Create the target directory if it does not already exist.

    Parameters
    ----------
    path : pathlib.Path
        Directory that must exist after this call.
    """
    try:
        path.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        sys.stderr.write(f"❌ Failed to create directory {path!s}: {exc}\\n")
        raise


def write_hello_world_file(file_path: pathlib.Path, source: str) -> None:
    """
    Write the supplied source code to ``file_path`` atomically.

    The file is opened with ``encoding='utf-8'`` and ``newline='\\n'`` to
    guarantee a reproducible, cross‑platform text file.

    Parameters
    ----------
    file_path : pathlib.Path
        Full path of the file to create/overwrite.
    source : str
        The exact source code string that will be written.
    """
    try:
        # Write using a temporary name then rename for atomicity.
        tmp_path = file_path.with_suffix(".tmp")
        with tmp_path.open("w", encoding="utf-8", newline="\n") as fp:
            fp.write(source)
        tmp_path.replace(file_path)
        # Make the script executable on POSIX systems.
        file_path.chmod(file_path.stat().st_mode | 0o111)
    except OSError as exc:
        sys.stderr.write(f"❌ Failed to write {file_path!s}: {exc}\\n")
