#!/usr/bin/env python3
"""
generate_hello.py

Creates a minimal “Hello, World!” Python program and saves it as
hello_world/hello_world.py.

Usage
-----
$ python generate_hello.py
"""

from __future__ import annotations

import pathlib
import sys
from typing import Final

# ----------------------------------------------------------------------
# Configuration (constants)
# ----------------------------------------------------------------------
# Base directory where the generated script will be placed.
TARGET_DIR: Final[pathlib.Path] = pathlib.Path(__file__).resolve().parent / "hello_world"

# Full path of the generated script.
TARGET_FILE: Final[pathlib.Path] = TARGET_DIR / "hello_world.py"

# Exact source code of the hello‑world program that will be written.
HELLO_WORLD_SOURCE: Final[str] = """#!/usr/bin/env python3
\"\"\"hello_world.py

A minimal script that prints “Hello, World!” when executed.
\"\"\"

def main() -> None:
    \"\"\"Entry point – prints a greeting to standard output.\"\"\"
    print("Hello, World!")


if __name__ == "__main__":
    # When the module is executed as a script, invoke the main function.
    main()
"""

# ----------------------------------------------------------------------
# Helper utilities
# ----------------------------------------------------------------------
def ensure_dir(path: pathlib.Path) -> None:
    """
    Guarantee that ``path`` exists as a directory.

    Parameters
    ----------
    path : pathlib.Path
        Directory that must exist after this call.
    """
    try:
        path.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        sys.stderr.write(f"❌ Unable to create directory {path!s}: {exc}\\n")
        raise


def atomic_write(file_path: pathlib.Path, content: str) -> None:
    """
    Write *content* to *file_path* atomically.

    The function writes to a temporary file first, then renames it to the
    final destination, guaranteeing that other processes never see a half‑written
    file.  The resulting file is also given execute permission on POSIX systems.

    Parameters
    ----------
    file_path : pathlib.Path
        Destination file.
    content : str
        Text to be written (UTF‑8 encoded).
    """
    try:
        tmp_path = file_path.with_suffix(".tmp")
        with tmp_path.open("w", encoding="utf-8", newline="\n") as fp:
            fp.write(content)
        # Rename replaces the old file atomically.
        tmp_path.replace(file_path)

        # Make the script executable (chmod +x) on Unix‑like platforms.
        file_path.chmod(file_path.stat().st_mode | 0o111)
    except OSError as exc:
        sys.stderr.write(f"❌ Failed to write {file_path!s}: {exc}\\n")
        raise


# ----------------------------------------------------------------------
# Main orchestration
# ----------------------------------------------------------------------
def main() -> None:
    """
    Orchestrates the creation of the hello‑world script.
    """
    print(f"🚀 Generating hello‑world script at: {TARGET_FILE}")

    # 1️⃣ Ensure the target directory exists.
    ensure_dir(TARGET_DIR)

    # 2️⃣ Write the script atomically.
    atomic_write(TARGET_FILE, HELLO_WORLD_SOURCE)

    # 3️⃣ Friendly completion message with usage hint.
    print("✅ Generation complete.\n")
    rel_path = TARGET_FILE.relative_to(pathlib.Path.cwd())
    print("Run the generated script with:")
    print(f"    python {rel_path}")
    print("\nExpected output:")
    print("    Hello, World!")


if __name__ == "__main__":
    main()
```

### Key Features

| Feature | Implementation Detail | Reason |
|---------|-----------------------|--------|
| **Cross‑platform path handling** | `pathlib.Path` is used everywhere | Avoids OS‑specific bugs. |
| **Atomic file write** | Write to `*.tmp` then `replace` | Guarantees a fully‑written file even if the process crashes. |
| **Executable permission** | `chmod(... | 0o111)` after write | Allows `./hello_world.py` to be run directly on POSIX. |
| **Self‑documenting constants** | `TARGET_DIR`, `TARGET_FILE`, `HELLO_WORLD_SOURCE` | Makes the script easy to adjust or extend. |
| **Typed signatures** | `def foo() -> None:` and `Final[...]` | Improves readability and static checking. |
| **Clear user feedback** | Print statements before/after generation | Confirms success and shows next steps. |

