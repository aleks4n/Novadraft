```python
# hello_world_file_io.py
"""
A minimal, fully functional example that showcases
* writing a plain‑text file
* reading it back
* saving/loading a PyTorch model checkpoint
* storing a JSON configuration
* persisting a NumPy array
"""

import json
from pathlib import Path

import numpy as np
import torch
import torch.nn as nn


# ----------------------------------------------------------------------
# 1. Plain‑text I/O (Hello‑World)
# ----------------------------------------------------------------------
def write_hello(path: Path) -> None:
    """Write 'Hello, World!' to a text file."""
    # Using a context manager guarantees proper closing.
    with path.open("w", encoding="utf-8") as f:
        f.write("Hello, World!\n")


def read_hello(path: Path) -> str:
    """Read the content of the hello file."""
    with path.open("r", encoding="utf-8") as f:
        return f.read()


# ----------------------------------------------------------------------
# 2. JSON configuration I/O
# ----------------------------------------------------------------------
def save_config(config: dict, path: Path) -> None:
    """Serialize a dictionary as pretty‑printed JSON."""
    with path.open("w", encoding="utf-8") as f:
        json.dump(config, f, indent=4, sort_keys=True)


def load_config(path: Path) -> dict:
    """Deserialize JSON back to a dictionary."""
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


# ----------------------------------------------------------------------
# 3. NumPy array persistence
# ----------------------------------------------------------------------
def save_numpy(arr: np.ndarray, path: Path) -> None:
    """Save a NumPy array in .npy format (binary, fast, portable)."""
    np.save(path, arr)


def load_numpy(path: Path) -> np.ndarray:
    """Load a NumPy array saved with np.save."""
    return np.load(path)


# ----------------------------------------------------------------------
# 4. PyTorch model checkpoint I/O
# ----------------------------------------------------------------------
class SimpleMLP(nn.Module):
    """A tiny multilayer perceptron used for demonstration."""
    def __init__(self, in_dim: int = 10, hidden_dim: int = 32, out_dim: int = 2):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, out_dim),
        )

    def forward(self, x):
        return self.net(x)


def save_checkpoint(model: nn.Module, optimizer: torch.optim.Optimizer,
                    epoch: int, path: Path) -> None:
    """Serialize model state, optimizer state, and training metadata."""
    checkpoint = {
        "epoch": epoch,
        "model_state_dict": model.state_dict(),
        "optimizer_state_dict": optimizer.state_dict(),
    }
    torch.save(checkpoint, path)


def load_checkpoint(model: nn.Module, optimizer: torch.optim.Optimizer,
                    path: Path) -> int:
    """Restore model and optimizer state; returns the epoch stored in the file."""
    ckpt = torch.load(path, map_location="cpu")
    model.load_state_dict(ckpt["model_state_dict"])
    optimizer.load_state_dict(ckpt["optimizer_state_dict"])
    return ckpt["epoch"]


# ----------------------------------------------------------------------
# 5. End‑to‑end demo
# ----------------------------------------------------------------------
def main() -> None:
    base_dir = Path("./demo_io")
    base_dir.mkdir(exist_ok=True)

    # 1. Hello‑world text file
    hello_path = base_dir / "hello.txt"
    write_hello(hello_path)
    print("Text file content:", read_hello(hello_path).strip())

    # 2. JSON config
    cfg = {"model": "SimpleMLP", "learning_rate": 1e-3, "seed": 42}
    cfg_path = base_dir / "config.json"
    save_config(cfg, cfg_path)
    print("Loaded config:", load_config(cfg_path))

    # 3. NumPy array
    arr = np.random.randn(5, 3).astype(np.float32)
    arr_path = base_dir / "array.npy"
    save_numpy(arr, arr_path)
    print("Array loaded back:\n", load_numpy(arr_path))

    # 4. PyTorch checkpoint
    model = SimpleMLP()
    optimizer = torch.optim.Adam(model.parameters(), lr=cfg["learning_rate"])
    ckpt_path = base_dir / "checkpoint.pt"
    save_checkpoint(model, optimizer, epoch=0, path=ckpt_path)

    # Simulate a tiny training step
    dummy_input = torch.randn(2, 10)
    loss = model(dummy_input).sum()
    loss.backward()
    optimizer.step()

    # Load checkpoint (restores to epoch 0, before the step above)
    loaded_epoch = load_checkpoint(model, optimizer, ckpt_path)
    print(f"Checkpoint restored – epoch = {loaded_epoch}")

if __name__ == "__main__":
    main()
```

