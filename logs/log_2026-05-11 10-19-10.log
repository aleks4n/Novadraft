# hello_world_file_io.py
"""
Full demonstration of “File I/O in Python” – the only concrete
implementation relevant to the request.

Features
--------
1. Write and read a plain‑text “Hello, World!” file.
2. Save and load a JSON configuration dictionary.
3. Persist a NumPy array in .npy format.
4. Store and restore a PyTorch model checkpoint (model + optimizer + epoch).

All operations are performed with idiomatic, safe Python constructs
(context managers, pathlib) and can be dropped into any of the listed
repositories (CompVis/taming‑transformers, VQGAN‑pytorch, vqvae‑pytorch,
kohonen‑vae, CLIP).
"""

from pathlib import Path
import json

import numpy as np
import torch
import torch.nn as nn


# ----------------------------------------------------------------------
# 1. Plain‑text I/O
# ----------------------------------------------------------------------
def write_hello(path: Path) -> None:
    """Write the classic greeting to a text file."""
    with path.open("w", encoding="utf-8") as f:
        f.write("Hello, World!\n")


def read_hello(path: Path) -> str:
    """Read the greeting back from the file."""
    with path.open("r", encoding="utf-8") as f:
        return f.read()


# ----------------------------------------------------------------------
# 2. JSON configuration I/O
# ----------------------------------------------------------------------
def save_json(cfg: dict, path: Path) -> None:
    """Save a configuration dict as pretty‑printed JSON."""
    with path.open("w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, sort_keys=True)


def load_json(path: Path) -> dict:
    """Load a JSON configuration file."""
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


# ----------------------------------------------------------------------
# 3. NumPy array persistence
# ----------------------------------------------------------------------
def save_numpy(arr: np.ndarray, path: Path) -> None:
    """Save a NumPy array to a binary .npy file."""
    np.save(path, arr)


def load_numpy(path: Path) -> np.ndarray:
    """Load a NumPy array saved with np.save."""
    return np.load(path)


# ----------------------------------------------------------------------
# 4. PyTorch checkpoint I/O
# ----------------------------------------------------------------------
class SimpleMLP(nn.Module):
    """Minimal multilayer perceptron used only for the I/O demo."""
    def __init__(self, in_dim: int = 10, hidden: int = 32, out_dim: int = 2):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, hidden),
            nn.ReLU(),
            nn.Linear(hidden, out_dim),
        )

    def forward(self, x):
        return self.net(x)


def save_checkpoint(model: nn.Module,
                    optimizer: torch.optim.Optimizer,
                    epoch: int,
                    path: Path) -> None:
    """Serialize model + optimizer state together with the epoch."""
    ckpt = {
        "epoch": epoch,
        "model_state_dict": model.state_dict(),
        "optimizer_state_dict": optimizer.state_dict(),
    }
    torch.save(ckpt, path)


def load_checkpoint(model: nn.Module,
                    optimizer: torch.optim.Optimizer,
                    path: Path) -> int:
    """Restore model + optimizer and return the stored epoch."""
    ckpt = torch.load(path, map_location="cpu")
    model.load_state_dict(ckpt["model_state_dict"])
    optimizer.load_state_dict(ckpt["optimizer_state_dict"])
    return ckpt["epoch"]


# ----------------------------------------------------------------------
# 5. Demonstration driver
# ----------------------------------------------------------------------
def main() -> None:
    base = Path("./demo_io")
    base.mkdir(exist_ok=True)

    # --- 1. Hello‑world text file ------------------------------------
    txt_path = base / "hello.txt"
    write_hello(txt_path)
    print("Text file →", read_hello(txt_path).strip())

    # --- 2. JSON config -----------------------------------------------
    cfg = {"model": "SimpleMLP", "lr": 1e-3, "seed": 1234}
    cfg_path = base / "config.json"
    save_json(cfg, cfg_path)
    print("Loaded config →", load_json(cfg_path))

    # --- 3. NumPy array -----------------------------------------------
    arr = np.random.randn(4, 5).astype(np.float32)
    arr_path = base / "array.npy"
    save_numpy(arr, arr_path)
    print("Array back →\n", load_numpy(arr_path))

    # --- 4. PyTorch checkpoint ----------------------------------------
    model = SimpleMLP()
    optimizer = torch.optim.Adam(model.parameters(), lr=cfg["lr"])
    ckpt_path = base / "checkpoint.pt"

    # Save initial state (epoch 0)
    save_checkpoint(model, optimizer, epoch=0, path=ckpt_path)

    # Simulate a tiny training step to change the state
    dummy = torch.randn(2, 10)
    loss = model(dummy).sum()
    loss.backward()
    optimizer.step()

    # Reload the checkpoint (restores to epoch 0)
    restored_epoch = load_checkpoint(model, optimizer, ckpt_path)
    print(f"Checkpoint restored – epoch = {restored_epoch}")

if __name__ == "__main__":
    main()
