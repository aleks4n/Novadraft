import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).parent
SCRIPT = PROJECT_ROOT / "run_hello_world.py"

def run_script() -> str:
    """Execute ``run_hello_world.py`` and capture stdout.

    Returns
    -------
    str
        Captured standard output (decoded as UTF‑8).
    """
    result = subprocess.run(
