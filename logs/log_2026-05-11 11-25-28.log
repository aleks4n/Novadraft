#!/usr/bin/env python3
"""
create_hello_world.py

Creates a minimal, production‑ready “Hello World” Python project in
`/workplace/hello_world`.  The script performs the following actions:

1. Guarantees the target directory exists (makes it if needed).
2. Writes a clean, PEP‑8‑compliant hello_world.py module.
3. Writes a tiny runner script (run_hello_world.py) that imports and
   executes the hello_world function.
4. Adds an optional __init__.py so the folder can be imported as a package.
5. Writes a tiny unit‑test (test_hello_world.py) that checks the printed
   output without using external testing frameworks (just `subprocess`).

All files are created with explicit UTF‑8 encoding and are not overwritten
unless the user confirms.
"""

import os
import sys
import pathlib
import textwrap
import subprocess

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
TARGET_ROOT = pathlib.Path("/workplace/hello_world")  # absolute target directory
PYTHON_FILE = TARGET_ROOT / "hello_world.py"
RUNNER_FILE = TARGET_ROOT / "run_hello_world.py"
INIT_FILE = TARGET_ROOT / "__init__.py"
TEST_FILE = TARGET_ROOT / "test_hello_world.py"

HELLO_WORLD_SOURCE = textwrap.dedent(
    \"\"\"\
    \"\"\"hello_world.py
    -----------------

    A tiny, reusable module that prints **Hello, World!** when its
    `main()` function is called.  The function returns the string as
    well, which makes it easy to unit‑test.

    Example
    -------
    >>> from hello_world import main
    >>> main()
    'Hello, World!'
    \"\"\"

    def main() -> str:
        \"\"\"Return and print the classic greeting.

        Returns
        -------
        str
            The string ``'Hello, World!'``.
        \"\"\"
        greeting = "Hello, World!"
        print(greeting)
        return greeting

    if __name__ == "__main__":
        # When the module is executed directly, run the entry point.
        main()
    \"\"\"
)

RUNNER_SOURCE = textwrap.dedent(
    \"\"\"\
    \"\"\"run_hello_world.py
    ---------------------

    Convenience script that imports the `main` function from
    `hello_world.py` and executes it.  This mirrors the typical pattern
    used in many open‑source projects where the entry point lives in a
    separate module.
    \"\"\"

    from hello_world import main

    if __name__ == "__main__":
        main()
    \"\"\"
)

TEST_SOURCE = textwrap.dedent(
    \"\"\"\
    \"\"\"test_hello_world.py
    -----------------------

    Very small regression test that invokes the module via a subprocess
    and checks that the exact output (including the trailing newline)
    matches the expected string.
    \"\"\"

    import subprocess
    import sys
    from pathlib import Path

    PROJECT_ROOT = Path(__file__).parent
    SCRIPT = PROJECT_ROOT / "run_hello_world.py"

    def run_script() -> str:
        \"\"\"Execute ``run_hello_world.py`` and capture stdout.\n\n        Returns\n        -------\n        str\n            The captured standard output (decoded as UTF‑8).\n        \"\"\"\n        result = subprocess.run(
            [sys.executable, str(SCRIPT)],
            check=True,
            capture_output=True,
            text=True,
        )
        return result.stdout

    def test_output():
        expected = "Hello, World!\\n"
        actual = run_script()
        assert actual == expected, f\"Expected {expected!r}, got {actual!r}\"

    if __name__ == \"__main__\":
        test_output()
        print(\"All tests passed.\")
    \"\"\"
)

# ----------------------------------------------------------------------
# Helper utilities
# ----------------------------------------------------------------------
def ask_overwrite(path: pathlib.Path) -> bool:
