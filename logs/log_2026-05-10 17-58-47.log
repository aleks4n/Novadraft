## 4. Full Implementation (no placeholders)

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
hello_world_writer.py

Utility to create a minimal Python script that prints "Hello, World!".
The implementation follows the robust file‑writing practices used in
the reference deep‑learning code bases (e.g., checkpoint saving in
Transformer, VQ‑VAE, CLIP, FSQ).

Author:  <your name>
Date:    2026‑05‑10
"""

from __future__ import annotations

import os
import tempfile
from pathlib import Path
from typing import Final


# ----------------------------------------------------------------------
# Constants
# ----------------------------------------------------------------------
SCRIPT_CONTENT: Final[str] = """\
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

def main() -> None:
    print("Hello, World!")

if __name__ == "__main__":
    main()
"""


def _atomic_write(path: Path, data: str) -> None:
    """
    Write *data* to *path* atomically.

    Steps:
        1. Create a temporary file in the same directory (so rename stays on one filesystem).
        2. Write UTF‑8 encoded data.
        3. Flush OS buffers (fsync) to guarantee persistence.
        4. Close the temp file.
        5. Replace the target path with the temp file (os.replace is atomic).

    Raises
    ------
    OSError
        If any OS operation fails.
    """
    # Ensure the parent directory exists – caller should have done this,
    # but we double‑check for safety.
    path.parent.mkdir(parents=True, exist_ok=True)

    # NamedTemporaryFile with delete=False so we can rename it later.
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        newline="\n",
        dir=str(path.parent),
        prefix=path.name,
        suffix=".tmp",
        delete=False,
    ) as tmp:
        tmp.write(data)
        tmp.flush()
        os.fsync(tmp.fileno())
        temp_name = Path(tmp.name)

    # os.replace works on both POSIX and Windows and is atomic.
    os.replace(str(temp_name), str(path))


def write_hello_world(
    target_dir: str | os.PathLike = ".",
    filename: str = "hello_world.py",
    overwrite: bool = False,
) -> Path:
    """
    Create a file ``filename`` inside ``target_dir`` that prints "Hello, World!".

    Parameters
    ----------
    target_dir : str | PathLike
        Destination directory; will be created recursively if missing.
    filename : str
        Name of the script; must end with ``.py``.
    overwrite : bool, default=False
        If ``False`` and the file already exists, a ``FileExistsError`` is raised.
        If ``True`` the existing file is replaced atomically.

    Returns
    -------
    pathlib.Path
        Absolute path of the created script.

    Examples
    --------
    >>> p = write_hello_world("./demo")
    >>> p.read_text(encoding="utf-8")[:30]
    '#!/usr/bin/env python3\\n# -*- ca'
    """
    # Normalise inputs -------------------------------------------------
    target_path = Path(target_dir).expanduser().resolve()
    target_path.mkdir(parents=True, exist_ok=True)

    if not filename.lower().endswith(".py"):
        raise ValueError("Filename must end with '.py'")

    script_path = target_path / filename

    if script_path.exists() and not overwrite:
        raise FileExistsError(f"The file {script_path} already exists. Set overwrite=True to replace it.")

    # Perform the atomic write -----------------------------------------
    _atomic_write(script_path, SCRIPT_CONTENT)

    # Make the script executable on POSIX systems (optional but convenient)
    try:
        script_path.chmod(script_path.stat().st_mode | 0o111)  # add execute bits
    except PermissionError:
        # On Windows the chmod call may be a no‑op; we silently ignore.
        pass

    return script_path


# ----------------------------------------------------------------------
# Simple self‑test when the module is executed directly
# ----------------------------------------------------------------------
if __name__ == "__main__":
    import argparse
    import subprocess
    import sys

    parser = argparse.ArgumentParser(
        description="Generate a hello‑world Python script."
    )
    parser.add_argument(
        "-d", "--dir", default=".", help="Target directory (default: current directory)."
    )
    parser.add_argument(
        "-f",
        "--file",
        default="hello_world.py",
        help="Filename to write (default: hello_world.py).",
    )
    parser.add_argument(
        "-o",
        "--overwrite",
        action="store_true",
        help="Overwrite the file if it already exists.",
    )
    args = parser.parse_args()

    try:
        created = write_hello_world(args.dir, args.file, args.overwrite)
        print(f"Created script at: {created}")
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    # Verify that the script runs and produces the expected output
    result = subprocess.run(
        [sys.executable, str(created)], capture_output=True, text=True, check=True
    )
    assert result.stdout.strip() == "Hello, World!"
    print("✅ Validation succeeded – script prints the correct message.")
```

### Key Points in the Code

| Line/Section | Why it matters for robust code (as demonstrated in the papers) |
|--------------|-------------------------------------------------------------------|
| `tempfile.NamedTemporaryFile(..., delete=False)` | Mirrors the checkpoint‑saving pattern in the Transformer repo – writes to a temp file first. |
| `os.fsync(tmp.fileno())` | Guarantees data is flushed to disk, similar to how large VQ‑GAN models ensure checkpoint durability. |
| `os.replace` | Atomic rename prevents partially‑written files; the same technique is used when publishing CLIP models. |
| `target_path.mkdir(parents=True, exist_ok=True)` | Guarantees directories exist, just like the training scripts that create `logs/`, `checkpoints/`, etc. |
