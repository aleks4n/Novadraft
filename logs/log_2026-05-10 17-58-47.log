## 1.  `hello_world_writer.py` – Full Source Code  

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
hello_world_writer.py

Utility to atomically create a tiny Python script that prints
"Hello, World!".  The implementation mirrors the safe‑write patterns
used throughout the reference deep‑learning code bases (e.g. checkpoint
saving in the Transformer, VQ‑VAE, CLIP, and FSQ papers).

Author  : <your name>
Date    : 2026‑05‑10
"""

from __future__ import annotations

import os
import tempfile
from pathlib import Path
from typing import Final

# ----------------------------------------------------------------------
# 1️⃣  The content that will be written to the generated file
# ----------------------------------------------------------------------
SCRIPT_CONTENT: Final[str] = """\
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

def main() -> None:
    \"\"\"Print the classic greeting.\"\"\"
    print("Hello, World!")

if __name__ == "__main__":
    main()
"""

# ----------------------------------------------------------------------
# 2️⃣  Helper: atomic write (temp file + os.replace)
# ----------------------------------------------------------------------
def _atomic_write(dst: Path, data: str) -> None:
    """
    Write `data` to `dst` atomically.

    Steps (exactly what the TensorFlow/torch checkpoint code does):
        1. Create a temporary file in the *same* directory.
        2. Write UTF‑8 data, flush, and fsync so the OS really persists it.
        3. Close the temp file.
        4. Rename the temporary file to the final name with `os.replace`
           (atomic on POSIX and Windows).

    Raises
    ------
    OSError
        If any underlying OS operation fails.
    """
    # The directory must exist – callers normally ensure this,
    # but we double‑check for safety.
    dst.parent.mkdir(parents=True, exist_ok=True)

    # NamedTemporaryFile with delete=False allows us to rename later.
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        newline="\n",
        dir=str(dst.parent),
        prefix=dst.name,
        suffix=".tmp",
        delete=False,
    ) as tmp:
        tmp.write(data)
        tmp.flush()
        os.fsync(tmp.fileno())
        temp_path = Path(tmp.name)

    # `os.replace` is atomic and works across platforms.
    os.replace(str(temp_path), str(dst))


# ----------------------------------------------------------------------
# 3️⃣  Public API: create the hello‑world script
# ----------------------------------------------------------------------
def write_hello_world(
    target_dir: str | os.PathLike = ".",
    filename: str = "hello_world.py",
    overwrite: bool = False,
) -> Path:
    """
    Write a Python script that prints ``Hello, World!`` into `target_dir`.

    Parameters
    ----------
    target_dir : str | PathLike
        Destination directory.  Missing parents are created automatically.
    filename : str, default="hello_world.py"
        Name of the script file; must have a ``.py`` suffix.
    overwrite : bool, default=False
        If ``False`` and the file already exists, a ``FileExistsError`` is raised.
        If ``True`` the existing file is replaced atomically.

    Returns
    -------
    pathlib.Path
        Absolute path to the created script.

    Raises
    ------
    ValueError
        If `filename` does not end with ``.py``.
    FileExistsError
        If the destination file exists and ``overwrite`` is ``False``.
    """
    # Normalise inputs -------------------------------------------------
    target = Path(target_dir).expanduser().resolve()
    target.mkdir(parents=True, exist_ok=True)

    if not filename.lower().endswith(".py"):
        raise ValueError("Filename must end with '.py'")

    script_path = target / filename

    if script_path.exists() and not overwrite:
        raise FileExistsError(
            f"The file {script_path} already exists. "
            "Pass overwrite=True to replace it."
        )

    # Write the file atomically ----------------------------------------
    _atomic_write(script_path, SCRIPT_CONTENT)

    # Make the script executable on POSIX (optional but convenient)
    try:
        script_path.chmod(script_path.stat().st_mode | 0o111)  # add execute bits
    except PermissionError:
        # Windows has no exec bits – ignore silently.
        pass

    return script_path


# ----------------------------------------------------------------------
# 4️⃣  Command‑line interface & self‑validation
# ----------------------------------------------------------------------
if __name__ == "__main__":
    import argparse
    import subprocess
    import sys

    parser = argparse.ArgumentParser(
        description="Generate a hello‑world Python script."
    )
    parser.add_argument(
        "-d",
        "--dir",
        default=".",
        help="Target directory (default: current working directory).",
    )
    parser.add_argument(
        "-f",
        "--file",
        default="hello_world.py",
        help="Filename to create (default: hello_world.py).",
    )
    parser.add_argument(
        "-o",
        "--overwrite",
        action="store_true",
        help="Overwrite the file if it already exists.",
    )
    args = parser.parse_args()

    try:
        created_path = write_hello_world(args.dir, args.file, args.overwrite)
        print(f"✅ Script created at: {created_path}")
    except Exception as exc:
        print(f"❌ Error: {exc}", file=sys.stderr)
        sys.exit(1)

    # ------------------------------------------------------------------
    # Quick validation: run the generated script and check its output.
    # ------------------------------------------------------------------
    result = subprocess.run(
        [sys.executable, str(created_path)],
        capture_output=True,
        text=True,
        check=True,
    )
    if result.stdout.strip() == "Hello, World!":
        print("✅ Validation succeeded – the script prints the correct message.")
    else:
        print("❌ Validation failed – unexpected script output.", file=sys.stderr)
        sys.exit(1)
```

