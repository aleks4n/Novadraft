## 1️⃣ Hello‑World Python File‑I/O Script

```python
# hello_world.py
"""
Minimal utility that demonstrates file I/O in Python.

Running the script creates (or overwrites) a file called ``hello.txt`` in the
same directory, containing the text "Hello, World!".

Usage
-----
    $ python hello_world.py
"""

import pathlib
import sys


def write_hello(dest: pathlib.Path) -> None:
    """
    Write the hello‑world string to *dest*.

    Parameters
    ----------
    dest : pathlib.Path
        Full path of the file that will be created/overwritten.
    """
    try:
        dest.write_text("Hello, World!", encoding="utf-8")
        print(f"✅ Successfully wrote to {dest}")
    except OSError as exc:
        print(f"❌ Failed to write to {dest}: {exc}", file=sys.stderr)
        raise


def main() -> None:
    # Resolve the target file relative to this script's location
    target_file = pathlib.Path(__file__).with_name("hello.txt")
    write_hello(target_file)


if __name__ == "__main__":
    main()
```

